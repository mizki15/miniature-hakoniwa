{
  "name": "hakoniwa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:lan": "vite --mode lan",
    "electron:dev": "node electron/dev.mjs",
    "electron:build": "tsc --noEmit && vite build --mode electron && electron-builder --win portable"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "io.github.mizki15.hakoniwa",
    "productName": "Hakoniwa",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Hakoniwa-portable.exe"
    }
  }
}
